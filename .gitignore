# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# What `wrangler dev` keeps of the local Worker (its Durable Objects included)
/worker/.wrangler/

# BOOTH PDFs, written by `bun run booth:pdf`
/booth/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# pnpm
pnpm-lock.yaml

# Claude Code worktrees and artifacts
/.claude/worktrees/
/feature/
/pr-conversation-summary.md

# npm lock file (using bun.lock instead)
package-lock.json
