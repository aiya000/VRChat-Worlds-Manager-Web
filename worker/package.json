  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12",
    "wrangler": "^4.158.0"
  }
